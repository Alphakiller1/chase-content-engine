{
  "_contract_version": "2.0.0",
  "_governed_by": "design/CONTENT_DESIGN_CONTRACT.md",
  "_public_site_contracts": {
    "mlb": "/data/public/mlb/slate.json",
    "nfl": "/data/public/nfl/slate.json",
    "nfl_team_context": "/data/public/nfl/team_context.json",
    "rule": "Preserve published values and ranks. Never infer an absent value as zero."
  },
  "mlb-live-slate": {
    "source": "chase-analytics public MLB slate",
    "sort": "kickoff_utc_ascending",
    "cards_per_graphic": 5,
    "required_fields": [
      "teams and records",
      "start time",
      "probable starters and handedness",
      "published ERA or em-dash",
      "lineup status",
      "weather or explicit unavailable state"
    ],
    "prohibited_fields": ["invented model projection", "invented betting recommendation"]
  },
  "nfl-weekly": {
    "source": "chase-analytics public NFL slate",
    "group": "week",
    "sort": "kickoff_utc_ascending within week",
    "cards_per_graphic": 4,
    "required_fields": [
      "week",
      "teams and records",
      "start time only in the time position",
      "starting quarterback",
      "availability summary",
      "game state"
    ],
    "rule": "Every published game renders; model coverage never filters the slate."
  },
  "nfl-matchup": {
    "source": "chase-analytics public NFL slate nested matchup evidence",
    "graphics": [
      "starting offense and defense with availability",
      "scheme confrontation",
      "QB RB WR scheme production",
      "mirrored team form"
    ],
    "required_fields": [
      "position-based starting units",
      "Active designation when no injury designation exists",
      "defensive coverage frequency beside opponent offensive EPA",
      "blitz pressure and stacked-box frequency beside opponent response EPA",
      "QB RB and WR position sections",
      "league-relative rank coloring",
      "source season",
      "em-dash for absent evidence"
    ],
    "visual_rules": [
      "segmented block meters only",
      "red yellow green spectrum for rank and performance",
      "purple is brand or selection only",
      "mirrored teams share one scale",
      "no generic continuous progress bars"
    ]
  },
  "morning-slate": {
    "sort": "model_run_separation_desc",
    "max_graphics": 3,
    "cards_per_graphic_standard": 4,
    "cards_per_graphic_compact": 5,
    "card_height_px": [190, 220],
    "required_fields": [
      "game key",
      "start time",
      "away team logo + abbreviation",
      "home team logo + abbreviation",
      "away projected runs",
      "home projected runs",
      "separation label",
      "away pitcher IP/ER/K",
      "home pitcher IP/ER/K",
      "lineup state",
      "model confidence",
      "personal opinion tag"
    ],
    "prohibited_fields": [
      "win probability",
      "win probability bar",
      "pitcher portrait (default)"
    ]
  },
  "offensive-report": {
    "sections": [
      "top offenses vs RHP",
      "top offenses vs LHP",
      "risers",
      "fallers"
    ],
    "rows_per_section": 5,
    "required_fields": [
      "team logo + abbreviation",
      "OSI (league metricColor)",
      "recent-window OSI",
      "signed delta (league metricColor)",
      "explicit compared window"
    ]
  },
  "public-vs-sharp": {
    "sections": [
      "pitching",
      "moneyline",
      "totals"
    ],
    "rows_per_section": 4,
    "sort": "absolute_divergence_desc",
    "require_same_day_timestamp": true,
    "required_fields": [
      "game or player",
      "market and line",
      "public de-vigged probability (neutral identity)",
      "sharp de-vigged probability (purple identity)",
      "signed divergence (magnitude, not a bet)",
      "observation timestamp",
      "book coverage or confidence when available"
    ],
    "language": "observation-only (never play/lock/smart-money)"
  },
  "featured-matchup": {
    "status": "dropped",
    "note": "Not a contracted daily report. Do not render a featured-matchup graphic."
  }
}
