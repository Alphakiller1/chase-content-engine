{
  "_contract_version": "1.0.0",
  "_governed_by": "design/CONTENT_DESIGN_CONTRACT.md",
  "morning-slate": {
    "sort": "model_run_separation_desc",
    "max_graphics": 3,
    "cards_per_graphic_standard": 4,
    "cards_per_graphic_compact": 5,
    "card_height_px": [190, 220],
    "required_fields": [
      "game key",
      "start time",
      "away team logo + abbreviation",
      "home team logo + abbreviation",
      "away projected runs",
      "home projected runs",
      "separation label",
      "away pitcher IP/ER/K",
      "home pitcher IP/ER/K",
      "lineup state",
      "model confidence",
      "personal opinion tag"
    ],
    "prohibited_fields": [
      "win probability",
      "win probability bar",
      "pitcher portrait (default)"
    ]
  },
  "offensive-report": {
    "sections": [
      "top offenses vs RHP",
      "top offenses vs LHP",
      "risers",
      "fallers"
    ],
    "rows_per_section": 5,
    "required_fields": [
      "team logo + abbreviation",
      "OSI (league metricColor)",
      "recent-window OSI",
      "signed delta (league metricColor)",
      "explicit compared window"
    ]
  },
  "public-vs-sharp": {
    "sections": [
      "pitching",
      "moneyline",
      "totals"
    ],
    "rows_per_section": 4,
    "sort": "absolute_divergence_desc",
    "require_same_day_timestamp": true,
    "required_fields": [
      "game or player",
      "market and line",
      "public de-vigged probability (neutral identity)",
      "sharp de-vigged probability (purple identity)",
      "signed divergence (magnitude, not a bet)",
      "observation timestamp",
      "book coverage or confidence when available"
    ],
    "language": "observation-only (never play/lock/smart-money)"
  },
  "featured-matchup": {
    "status": "dropped",
    "note": "Not a contracted daily report. Do not render a featured-matchup graphic."
  }
}
